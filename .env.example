# HTTP port used by the application
PORT=3000

# PostgreSQL connection URL without the password
DB_URL=postgresql://marketplace:fake_password@127.0.0.1:6432/marketplace

# Path to the PostgreSQL password secret file
DB_PASSWORD_FILE=secrets/db_password

# Authentication (base64-encoded PEM values; generate local values with
# bash scripts/init-local-compose-secrets.sh .env.compose.local)
JWT_KID=local
JWT_PRIVATE_KEY=base64_encoded_private_pem
JWT_PUBLIC_KEY=base64_encoded_public_pem
REFRESH_TOKEN_PEPPER=replace_me

BROKER_URL=amqp://app:app@127.0.0.1:5672
REDIS_URL=redis://127.0.0.1:6381
REDIS_QUEUE_URL=redis://127.0.0.1:6382
PAYMENT_WEBHOOK_SECRET=replace_me
