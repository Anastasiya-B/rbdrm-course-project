{
  "name": "rbdrm-course-project",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "check:env": "node scripts/check-env-example.mjs",
    "migration:generate": "npm run build && bash scripts/with-secrets.sh dev npx typeorm migration:generate -d dist/data-source.js src/migrations/InitialSchema",
    "migrate": "bash scripts/with-secrets.sh dev npx typeorm migration:run -d dist/data-source.js",
    "migrate:show": "bash scripts/with-secrets.sh dev npx typeorm migration:show -d dist/data-source.js",
    "migrate:revert": "bash scripts/with-secrets.sh dev npx typeorm migration:revert -d dist/data-source.js",
    "seed": "bash scripts/with-secrets.sh dev node dist/seed.js",
    "demo:nplus1": "bash scripts/with-secrets.sh dev node dist/demo-nplus1.js",
    "demo:race": "bash scripts/with-secrets.sh dev node dist/demo-race.js",
    "demo:workers": "bash scripts/with-secrets.sh dev node dist/demo-workers.js",
    "demo:retry": "bash scripts/with-secrets.sh dev node dist/demo-retry.js",
    "report": "bash scripts/with-secrets.sh dev node dist/report.js",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand test/integration",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand test/e2e",
    "test:contract": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand test/contract/consumer",
    "verify:provider": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand test/contract/provider"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anastasiya-B/rbdrm-course-project.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Anastasiya-B/rbdrm-course-project/issues"
  },
  "homepage": "https://github.com/Anastasiya-B/rbdrm-course-project#readme",
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.28",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.3",
    "@pact-foundation/pact": "^17.1.4",
    "@redocly/cli": "^2.46.0",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
