{
  "name": "rbdrm-course-project",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "check:env": "node scripts/check-env-example.mjs",
    "migration:generate": "npm run build && bash scripts/with-secrets.sh dev npx typeorm migration:generate -d dist/data-source.js src/migrations/InitialSchema",
    "migrate": "bash scripts/with-secrets.sh dev npx typeorm migration:run -d dist/data-source.js",
    "migrate:show": "bash scripts/with-secrets.sh dev npx typeorm migration:show -d dist/data-source.js",
    "migrate:revert": "bash scripts/with-secrets.sh dev npx typeorm migration:revert -d dist/data-source.js",
    "seed": "bash scripts/with-secrets.sh dev node dist/seed.js",
    "demo:nplus1": "bash scripts/with-secrets.sh dev node dist/demo-nplus1.js",
    "report": "bash scripts/with-secrets.sh dev node dist/report.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anastasiya-B/rbdrm-course-project.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Anastasiya-B/rbdrm-course-project/issues"
  },
  "homepage": "https://github.com/Anastasiya-B/rbdrm-course-project#readme",
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.28",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@redocly/cli": "^2.46.0",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
