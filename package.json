{
  "name": "rbdrm-course-project",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "npm run build && node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "start:vault": "bash scripts/with-secrets.sh dev node dist/main.js",
    "check:env": "node scripts/check-env-example.mjs",
    "migration:generate": "npm run build && bash scripts/with-secrets.sh dev npx typeorm migration:generate -d dist/data-source.js src/migrations/InitialSchema",
    "migrate": "bash scripts/with-secrets.sh dev npx typeorm migration:run -d dist/data-source.js",
    "migrate:show": "bash scripts/with-secrets.sh dev npx typeorm migration:show -d dist/data-source.js",
    "migrate:revert": "bash scripts/with-secrets.sh dev npx typeorm migration:revert -d dist/data-source.js",
    "seed": "bash scripts/with-secrets.sh dev node dist/seed.js",
    "demo:nplus1": "bash scripts/with-secrets.sh dev node dist/demo-nplus1.js",
    "demo:race": "bash scripts/with-secrets.sh dev node dist/demo-race.js",
    "demo:workers": "bash scripts/with-secrets.sh dev node dist/demo-workers.js",
    "demo:retry": "bash scripts/with-secrets.sh dev node dist/demo-retry.js",
    "report": "bash scripts/with-secrets.sh dev node dist/report.js",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand test/integration",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand test/e2e",
    "test:contract": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand test/contract/consumer",
    "verify:provider": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand test/contract/provider",
    "demo:realtime": "node scripts/realtime-demo.mjs",
    "demo:publish": "bash scripts/with-secrets.sh dev node dist/demo-rabbit-publish.js",
    "demo:dlq": "bash scripts/with-secrets.sh dev node dist/demo-rabbit-dlq.js",
    "demo:duplicate": "bash scripts/with-secrets.sh dev node dist/demo-rabbit-duplicate.js",
    "demo:outbox": "bash scripts/with-secrets.sh dev node dist/demo-outbox.js",
    "demo:crash-write": "bash scripts/with-secrets.sh dev node dist/demo-crash-write.js",
    "demo:crash-relay": "bash scripts/with-secrets.sh dev node dist/demo-crash-relay.js",
    "demo:cache": "bash scripts/with-secrets.sh dev node dist/demo-cache.js",
    "demo:session": "bash scripts/with-secrets.sh dev node dist/demo-session.js",
    "demo:ratelimit": "bash scripts/with-secrets.sh dev node dist/demo-ratelimit.js",
    "demo:queue": "bash scripts/with-secrets.sh dev node dist/demo-queue.js",
    "demo:auth": "bash scripts/with-secrets.sh dev node dist/demo-auth.js",
    "demo:reuse": "bash scripts/with-secrets.sh dev node dist/demo-reuse.js",
    "demo:rbac": "bash scripts/with-secrets.sh dev node dist/demo-rbac.js",
    "demo:upload": "bash scripts/with-secrets.sh dev node dist/demo-upload.js",
    "demo:multipart": "bash scripts/with-secrets.sh dev node dist/demo-multipart.js",
    "demo:cdn": "bash scripts/with-secrets.sh dev node dist/demo-cdn.js",
    "image:build": "DOCKER_BUILDKIT=1 docker build --secret id=npm_token,src=.npm_token -f docker/Dockerfile -t rbdrm-marketplace:hw28 .",
    "demo:image": "bash demo/demo-image.sh",
    "scan": "bash scripts/scan-image.sh",
    "cluster:up": "bash scripts/cluster-up.sh",
    "cluster:down": "bash scripts/cluster-down.sh",
    "up": "bash scripts/with-secrets.sh dev bash scripts/pulumi-up.sh",
    "destroy": "bash scripts/with-secrets.sh dev bash scripts/pulumi-destroy.sh",
    "demo:rollout": "bash demo/demo-rollout.sh",
    "demo:pdb": "bash demo/demo-pdb.sh",
    "demo:logs": "bash scripts/with-secrets.sh dev bash demo/demo-logs.sh",
    "demo:metrics": "bash scripts/with-secrets.sh dev bash demo/demo-metrics.sh",
    "demo:trace": "bash scripts/with-secrets.sh dev bash demo/demo-trace.sh",
    "up:base": "bash scripts/with-secrets.sh dev bash scripts/hw31-up-base.sh",
    "destroy:base": "bash scripts/with-secrets.sh dev bash scripts/hw31-destroy-base.sh",
    "up:demo": "bash scripts/with-secrets.sh dev bash scripts/hw31-up-demo.sh",
    "destroy:demo": "bash scripts/with-secrets.sh dev bash scripts/hw31-destroy-demo.sh",
    "demo:alb": "bash scripts/with-secrets.sh dev bash demo/demo-alb.sh",
    "demo:failover": "bash scripts/with-secrets.sh dev bash demo/demo-failover.sh",
    "demo:nat": "bash scripts/with-secrets.sh dev bash demo/demo-nat.sh",
    "demo:oidc": "node demo/demo-oidc.mjs",
    "architecture": "dependency-cruise --config dependency-cruiser.config.mjs src",
    "gate:cost": "node -r ts-node/register scripts/hw32/cost-gate.ts",
    "demo:gates": "node scripts/hw32/demo-gates.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "gate:contract": "bash scripts/hw32/contract-gate.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anastasiya-B/rbdrm-course-project.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Anastasiya-B/rbdrm-course-project/issues"
  },
  "homepage": "https://github.com/Anastasiya-B/rbdrm-course-project#readme",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-socket.io": "^12.1.3",
    "@nestjs/websockets": "^12.1.3",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.83.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "amqplib": "^2.2.0",
    "bullmq": "^6.5.3",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "typeorm": "^0.3.28",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
